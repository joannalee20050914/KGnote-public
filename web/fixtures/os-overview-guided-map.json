      "evidence_ids": [
        "evidence_os_protection"
      ],
      "group_id": "group_os_protection_boundary"
    },
    {
      "id": "concept_context_switch",
      "label": "內容切換",
      "aliases": [
        "Context Switch"
      ],
      "summary": "CPU 從一個程序切換到另一個程序時，保存舊執行現場並載入新執行現場的過程。",
