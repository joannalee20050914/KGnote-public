{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgnote.local/schemas/guided-map/v1/guided-map-spec.schema.json",
  "title": "KGnote human-reviewed Guided Map specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "graph_snapshot_sha256", "projection_version", "display_locale", "title", "focus_question", "source_id", "source_locator", "groups", "teaching_propositions"],
  "properties": {
    "schema_version": {"const": "kgnote.guided-map-spec.v1"},
    "id": {"type": "string", "pattern": "^guided_map_[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "graph_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "projection_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "display_locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "title": {"$ref": "#/$defs/displayText"},
    "focus_question": {"$ref": "#/$defs/displayText"},
    "source_id": {"type": "string", "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "source_locator": {"$ref": "#/$defs/locator"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/group"}
    },
    "teaching_propositions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/teachingProposition"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "displayText": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$"},
    "idList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["line_range", "message_range", "page_range", "timestamp_range", "section"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "order", "concept_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^group_[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?=.*\\S)[^\\[\\]|#^\\r\\n]+$"},
        "order": {"type": "integer", "minimum": 1},
        "concept_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "teachingProposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "linking_phrase", "evidence_ids", "review_status"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^edge_[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "linking_phrase": {"type": "string", "minLength": 2, "maxLength": 80, "pattern": "^(?=.*\\S)[^\\r\\n]+$"},
        "evidence_ids": {"$ref": "#/$defs/idList"},
        "review_status": {"enum": ["accepted", "corrected"]}
      }
    }
  }
}
