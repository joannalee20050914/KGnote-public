{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgnote.local/schemas/product-review/v1/review-result.schema.json",
  "title": "KGnote GitHub product review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "repository",
    "pull_request",
    "program_id",
    "goal_id",
    "candidate_fingerprint",
    "candidate_commit",
    "review_round",
    "verdict",
    "findings",
    "native_ui_observed"
  ],
  "properties": {
    "protocol": {"const": "kgnote.product-review.v1"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pull_request": {"type": "integer", "minimum": 1},
    "program_id": {"type": "string", "minLength": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "candidate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "review_round": {"type": "integer", "minimum": 1, "maximum": 16},
    "verdict": {"enum": ["PASS", "CHANGES_REQUIRED", "PRODUCT_DECISION_REQUIRED"]},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "human_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/humanDecisionProposal"}
    },
    "native_ui_observed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PRODUCT_DECISION_REQUIRED"}}},
      "then": {
        "required": ["human_decisions"],
        "properties": {"human_decisions": {"minItems": 1}}
      },
      "else": {
        "properties": {"human_decisions": {"maxItems": 0}}
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "observation",
        "expected_behavior",
        "authority_refs",
        "candidate_evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^finding-[a-z0-9-]+$"},
        "severity": {"enum": ["blocking", "major", "minor"]},
        "category": {"enum": ["product_intent", "ux", "semantic", "architecture", "engineering"]},
        "observation": {"type": "string", "minLength": 1},
        "expected_behavior": {"type": "string", "minLength": 1},
        "authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "candidate_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "humanDecisionProposal": {
      "type": "object",
      "$comment": "linked_findings referential integrity against root findings is enforced by the repository Consumer because JSON Schema Draft 2020-12 cannot express that cross-array identity constraint.",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "question",
        "why_existing_authority_is_insufficient",
        "affected_requirements",
        "available_options",
        "observable_consequences",
        "blocking_scope",
        "linked_findings"
      ],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^D-[0-9]{3,}$"},
        "question": {"type": "string", "minLength": 1},
        "why_existing_authority_is_insufficient": {"type": "string", "minLength": 1},
        "affected_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "available_options": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "observable_consequences": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "blocking_scope": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "linked_findings": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^finding-[a-z0-9-]+$"}
        }
      }
    }
  }
}
