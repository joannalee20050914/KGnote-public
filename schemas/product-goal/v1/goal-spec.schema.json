{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgnote.local/schemas/product-goal/v1/goal-spec.schema.json",
  "title": "KGnote Product Goal specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "identity_kind", "authority_kind", "lifecycle_owner",
    "goal_id", "active_goal", "goal_version", "title", "outcome",
    "repository", "github_issue", "owner_logins", "requirements", "rcs",
    "fds", "dependencies", "allowed_operations", "forbidden_operations",
    "work_window", "resource_policy", "recovery_policy", "review_policy",
    "completion_conditions", "human_acceptance_required", "obligations",
    "work_items"
  ],
  "properties": {
    "schema_version": {"const": "kgnote.product-goal-spec.v1"},
    "identity_kind": {"const": "KGNOTE_PRODUCT_GOAL"},
    "authority_kind": {"const": "GITHUB_OWNER_APPROVAL"},
    "lifecycle_owner": {"const": "MAC_RUNNER"},
    "goal_id": {"type": "string", "pattern": "^GOAL-KGNOTE-[A-Z0-9-]+$"},
    "active_goal": {"type": "string"},
    "goal_version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "github_issue": {"type": "integer", "minimum": 1},
    "owner_logins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^KG-[A-Z]+-[0-9]{2}$"}},
    "rcs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RC-[0-9]{2}$"}},
    "fds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FD-[0-9]{2}$"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "work_window": {
      "type": "object", "additionalProperties": false,
      "required": ["timezone", "weekdays", "start", "end"],
      "properties": {
        "timezone": {"const": "Asia/Taipei"},
        "weekdays": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 6}},
        "start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
      }
    },
    "resource_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_model_concurrency", "providers"],
      "properties": {
        "max_model_concurrency": {"const": 1},
        "providers": {
          "type": "object", "additionalProperties": false,
          "required": ["codex", "claude"],
          "properties": {
            "codex": {"$ref": "#/$defs/provider"},
            "claude": {"$ref": "#/$defs/provider"}
          }
        }
      }
    },
    "recovery_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_same_failure_attempts", "no_progress_before_strategy_adjustment", "max_strategy_adjustments"],
      "properties": {
        "max_same_failure_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "no_progress_before_strategy_adjustment": {"const": 2},
        "max_strategy_adjustments": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "review_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "independent", "completion_gate_required", "round_has_hidden_fixed_limit"],
      "properties": {
        "reviewer": {"const": "UBUNTU_CLAUDE"},
        "independent": {"const": true},
        "completion_gate_required": {"const": true},
        "round_has_hidden_fixed_limit": {"const": false}
      }
    },
    "completion_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "human_acceptance_required": {"type": "boolean"},
    "obligations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["obligation_id", "semantic_key", "authority_refs", "description"],
        "properties": {
          "obligation_id": {"type": "string", "pattern": "^OBL-[A-Z0-9-]+$"},
          "semantic_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "authority_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "work_items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["work_item_id", "milestone_id", "kind", "dependencies", "obligation_ids", "allowed_operations", "provider"],
        "properties": {
          "work_item_id": {"type": "string", "pattern": "^WI-[A-Z0-9-]+$"},
          "milestone_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["IMPLEMENT", "VERIFY", "PUBLISH", "REVIEW", "REPAIR", "ACCEPTANCE_PREP"]},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "obligation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "provider": {"enum": ["NONE", "codex", "claude"]}
        }
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["subscription_only", "paid_api_fallback", "reserve_percent", "capacity_observation", "fallback"],
      "properties": {
        "subscription_only": {"const": true},
        "paid_api_fallback": {"const": false},
        "reserve_percent": {"const": 10},
        "capacity_observation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "remaining_percent", "source_kind", "observed_at", "max_age_seconds"],
          "properties": {
            "status": {"enum": ["TRUSTED", "PERCENTAGE_UNOBSERVABLE"]},
            "remaining_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "source_kind": {"type": ["string", "null"]},
            "observed_at": {"type": ["string", "null"], "format": "date-time"},
            "max_age_seconds": {"type": "integer", "minimum": 60}
          }
        },
        "fallback": {
          "type": "object", "additionalProperties": false,
          "required": ["min_launch_interval_seconds", "max_launches_per_window", "max_total_launches", "quota_backoff_seconds"],
          "properties": {
            "min_launch_interval_seconds": {"type": "integer", "minimum": 30},
            "max_launches_per_window": {"type": "integer", "minimum": 1},
            "max_total_launches": {"type": "integer", "minimum": 1},
            "quota_backoff_seconds": {"type": "integer", "minimum": 60}
          }
        }
      }
    }
  }
}
