{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgnote.local/schemas/product-goal/v1/backlog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity_kind", "authority_kind", "lifecycle_owner", "backlog_id", "source_baseline", "selection_policy", "items"],
  "properties": {
    "schema_version": {"const": "kgnote.product-goal-backlog.v1"},
    "identity_kind": {"const": "KGNOTE_PRODUCT_GOAL_BACKLOG"},
    "authority_kind": {"const": "PLANNING_ONLY_NO_EXECUTION_AUTHORITY"},
    "lifecycle_owner": {"const": "MAC_RUNNER"},
    "backlog_id": {"type": "string", "minLength": 1},
    "source_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_head", "requirements_baseline_id", "source_sha256"],
      "properties": {
        "repository_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "requirements_baseline_id": {"type": "string"},
        "source_sha256": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered", "previous_must_be_closed", "approval_grants_authority", "rescan_policy"],
      "properties": {
        "ordered": {"const": true},
        "previous_must_be_closed": {"const": true},
        "approval_grants_authority": {"const": false},
        "rescan_policy": {"const": "CHECK_NEXT_DEPENDENCIES_AND_RELEVANT_VERSION_DRIFT_ONLY"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "goal_id", "active_goal", "milestone_id", "identity_kind", "authority_kind", "lifecycle_owner", "goal_version", "roadmap_stage", "title", "status", "dependencies", "requirements", "scenarios", "rcs", "fds", "outcome", "completion_conditions", "forbidden_substitutes", "approval_eligibility", "existing_evidence_disposition"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "goal_id": {"type": "string", "pattern": "^GOAL-KGNOTE-[A-Z0-9-]+$"},
          "active_goal": {"type": "string"},
          "milestone_id": {"type": "string"},
          "identity_kind": {"const": "KGNOTE_PRODUCT_GOAL"},
          "authority_kind": {"const": "GITHUB_OWNER_APPROVAL_REQUIRED"},
          "lifecycle_owner": {"const": "MAC_RUNNER"},
          "goal_version": {"type": "string"},
          "roadmap_stage": {"type": "string", "pattern": "^O[2-7]$"},
          "title": {"type": "string"},
          "status": {"enum": ["PLANNED", "APPROVAL_REQUIRED", "APPROVED", "ACTIVE", "BLOCKED", "ACCEPTANCE_REQUIRED", "CLOSED"]},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "rcs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "fds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "outcome": {"type": "string"},
          "completion_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "forbidden_substitutes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "approval_eligibility": {"type": "object"},
          "existing_evidence_disposition": {"type": "object"}
        }
      }
    }
  }
}
