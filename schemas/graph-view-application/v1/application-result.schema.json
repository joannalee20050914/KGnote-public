{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgnote.local/schemas/graph-view-application/v1/application-result.schema.json",
  "title": "KGnote read-only graph view application result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status"],
  "properties": {
    "schema_version": {"const": "kgnote.graph-view-application.v1"},
    "status": {"enum": ["ready", "rejected"]},
    "view": {"$ref": "https://kgnote.local/schemas/graph-read-model/v1/graph-read-model.schema.json"},
    "plan": {"$ref": "https://kgnote.local/schemas/graph-view/v1/plan.schema.json"},
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "code", "path"],
      "properties": {
        "component": {"enum": ["store", "projector", "planner"]},
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "array", "items": {"type": ["string", "integer"]}}
      }
    }
  },
  "oneOf": [
    {
      "properties": {"status": {"const": "ready"}},
      "required": ["view", "plan"],
      "not": {"required": ["problem"]}
    },
    {
      "properties": {"status": {"const": "rejected"}},
      "required": ["problem"],
      "not": {"anyOf": [{"required": ["view"]}, {"required": ["plan"]}]}
    }
  ]
}
