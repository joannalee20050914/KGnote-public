{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgnote.local/schemas/formative-test-manifest/v1/manifest.schema.json",
  "title": "KGnote formative test manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "hypothesis_id", "title", "source", "pretest", "conditions", "primary_metrics", "rubric", "exclusion_criteria", "abort_criteria", "decision_rules", "limitations"],
  "properties": {
    "schema_version": {"const": "kgnote.formative-test-manifest.v1"},
    "id": {"type": "string", "pattern": "^experiment_[a-z0-9][a-z0-9_-]{2,127}$"},
    "hypothesis_id": {"const": "H0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "content_sha256", "revision", "fixture_path", "selected_range", "upstream", "reviewed_claims"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 160},
        "fixture_path": {"type": "string", "pattern": "^experiments/fixtures/[A-Za-z0-9_./-]+\\.md$"},
        "selected_range": {"$ref": "#/$defs/line_range"},
        "upstream": {
          "type": "object", "additionalProperties": false,
          "required": ["repository", "commit", "path", "content_sha256"],
          "properties": {
            "repository": {"type": "string", "minLength": 1, "maxLength": 120},
            "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "path": {"type": "string", "pattern": "^[A-Za-z0-9_.\/-]+$"},
            "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "reviewed_claims": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "statement", "source_range", "upstream_ranges", "review_status"],
            "properties": {
              "id": {"type": "string", "pattern": "^claim_[a-z0-9][a-z0-9_-]{2,127}$"},
              "statement": {"type": "string", "minLength": 1, "maxLength": 800},
              "source_range": {"$ref": "#/$defs/line_range"},
              "upstream_ranges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line_range"}},
              "review_status": {"const": "source_verified"}
            }
          }
        }
      }
    },
    "pretest": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "rating_scale", "eligible_ratings", "must_run_before_source_visible"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
        "rating_scale": {
          "type": "array", "minItems": 3, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {"value": {"type": "integer", "minimum": 0, "maximum": 4}, "label": {"type": "string", "minLength": 1, "maxLength": 240}}
          }
        },
        "eligible_ratings": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 4}},
        "must_run_before_source_visible": {"const": true}
      }
    },
    "conditions": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["condition_id", "interface", "source_range", "task", "timebox_seconds", "allowed_tools", "lookup_prompt", "unaided_prompt"],
        "properties": {
          "condition_id": {"enum": ["baseline_markdown", "kgnote_no_graph"]},
          "interface": {"type": "string", "minLength": 1, "maxLength": 240},
          "source_range": {"$ref": "#/$defs/line_range"},
          "task": {"type": "string", "minLength": 1, "maxLength": 1000},
          "timebox_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
          "allowed_tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
          "lookup_prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
          "unaided_prompt": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "primary_metrics": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["organizing_seconds", "help_count", "save_reopen_success", "lookup_seconds", "lookup_errors", "unaided_rubric_score", "reported_friction"]}
    },
    "rubric": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension", "description", "max_points"],
        "properties": {
          "dimension": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 600},
          "max_points": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    },
    "exclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "abort_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "decision_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["continue", "modify", "stop"],
      "properties": {
        "continue": {"type": "string", "minLength": 1, "maxLength": 1000},
        "modify": {"type": "string", "minLength": 1, "maxLength": 1000},
        "stop": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  },
  "$defs": {
    "line_range": {"type": "string", "pattern": "^L[1-9][0-9]*-L[1-9][0-9]*$"}
  }
}
