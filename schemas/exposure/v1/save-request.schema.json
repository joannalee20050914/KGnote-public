{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kgnote.local/schemas/exposure/v1/save-request.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","event_id","exposure_session_id","learning_unit_id","item_id","concept_id","kind","occurred_at","source_refs"],
  "properties":{
    "schema_version":{"const":"kgnote.exposure-save-request.v1"},
    "event_id":{"type":"string","pattern":"^exposure_[a-f0-9]{32}$"},
    "exposure_session_id":{"type":"string","pattern":"^soak_[a-f0-9]{32}$"},
    "learning_unit_id":{"type":"string","minLength":1,"maxLength":200},
    "item_id":{"type":"string","minLength":1,"maxLength":200},
    "concept_id":{"type":"string","minLength":1,"maxLength":200},
    "kind":{"enum":["presented","answer_revealed","skipped","encountered","recognized","applied"]},
    "occurred_at":{"type":"string","format":"date-time"},
    "source_refs":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}}
  }
}
