{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgnote.local/schemas/learning-note/v1/learning-note.schema.json",
  "title": "KGnote LearningNote v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "type", "notebook_id", "learning_unit_id",
    "revision", "title", "source_anchors", "created_at", "updated_at",
    "last_save_id", "last_request_sha256", "markdown"
  ],
  "properties": {
    "schema_version": {"const": "kgnote.learning-note.v1"},
    "id": {"type": "string", "pattern": "^note_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "type": {"const": "learning_note"},
    "notebook_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "learning_unit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_anchors": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/source_anchor"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "last_save_id": {"type": "string", "pattern": "^save_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"},
    "last_request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "markdown": {"type": "string", "maxLength": 262144}
  },
  "$defs": {
    "source_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "locator", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^anchor_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "source_id": {"type": "string", "pattern": "^src_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "line_range"},
            "value": {"type": "string", "pattern": "^L[1-9][0-9]*-L[1-9][0-9]*$"}
          }
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
